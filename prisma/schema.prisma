datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id          String    @id
  shop        String
  state       String
  isOnline    Boolean   @default(false)
  scope       String?
  expires     DateTime?
  accessToken String
  userId      BigInt?
}

model StoreSettings {
  shop        String    @id
  plan        String    @default("FREE")
  usageCount  Int       @default(0)
  createdAt   DateTime  @default(now())
}
